# Required application secret: generate a unique random value of 32+ characters.
JWT_SECRET=replace_with_a_unique_32_plus_character_secret
IP_HASH_SECRET=replace_with_a_different_random_secret

# Database and server
MONGO_URI=mongodb://localhost:27017/university_mfa
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5500,http://127.0.0.1:5500
FRONTEND_PUBLIC_URL=http://localhost:5500

# WebAuthn / passkeys
WEBAUTHN_RP_NAME=IILM University Portal
WEBAUTHN_RP_ID=localhost
OTP_EXPIRY_MINUTES=5

# Preferred transactional email provider: Resend
# Verify the sender domain in Resend before using it.
RESEND_API_KEY=
EMAIL_FROM=IILM University Portal <security@example.edu>

# Optional local-development Gmail SMTP fallback
EMAIL_USER=
EMAIL_PASS=
ADMIN_EMAIL=admin@iilm.edu
